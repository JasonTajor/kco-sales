# ---------------------------------------------------------------------------
# KCO Sales & Learning Management System - environment
#
# Copy to .env.local and fill in the values from your Supabase project:
#   Supabase dashboard -> Project Settings -> API
#
# Only these variables reach the browser. Vite inlines every VITE_-prefixed
# value into the client bundle, so NEVER put the service role key here or in
# any other VITE_ variable - it bypasses Row Level Security entirely.
# ---------------------------------------------------------------------------

# Project URL, e.g. https://abcdefghijklm.supabase.co
VITE_SUPABASE_URL=your-project-url

# The publishable client key. Labelled "anon public" in older projects and
# "publishable key" in newer ones; either works.
VITE_SUPABASE_ANON_KEY=your-anon-key

# Optional. Where OAuth should return the user. Defaults to window.location.origin,
# which is correct for local development and most deployments. Set it when the
# app is served from a path or behind a proxy that rewrites the origin.
# VITE_SITE_URL=https://learning.example.com

# ---------------------------------------------------------------------------
# Leaving the two required values unset is supported: the app then runs in
# demo mode against an in-browser store and shows a banner saying so. Nothing
# is written to a server in that mode.
# ---------------------------------------------------------------------------
